// Token gallery — open in Craft Dark, Craft Light and your own theme.
struct Account {
    let name: String
    var balance: Int
}

func deposit(account: Account, amount: Int): Int {
    return account.balance + amount
}

func main() {
    let บัญชี: Account = Account(name: "โลก", balance: 42)
    let gift: String = "if // var \n \u0E01"
    let ifไทย: Float = 1.25e-3
    let nested: Map<String, Map<String, Int?>> = {"outer": {"inner": null}}
    let arrays: Int[]? = [1, 2, 3]
    if let values = arrays {
        for i in 0..values.length {
            assert i < 3 && true
        }
    }
    print(deposit(amount: 2, account: บัญชี), gift.trim().upper(), ifไทย)
}

