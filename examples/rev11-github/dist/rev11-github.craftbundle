        {
          "path": "src/greeting.craft",
          "text": "export func greet(name: String): String {\n    let cleaned: String = name.trim()\n    if cleaned == \"\" {\n        return \"Hello, stranger!\"\n    }\n    return \"Hello, \" + cleaned + \"!\"\n}\n\nexport func isBlank(value: String): Bool {\n    return value.trim() == \"\"\n}\n"
        }
      ]
    }
