test "HTTP runtime dispatch" {
    let health: HttpResponse = dispatch(std.http.request("GET", "/health", std.bytes.fromString("")), 0)
    assert health.status == 200
    assert std.json.parse(health.body.text()).asObject().require("language").asString() == "craft"

    var create: HttpRequest = std.http.request("POST", "/items", std.bytes.fromString("{}"))
    assert dispatch(create, 0).status == 415
    create.headers.set("content-type", ["application/json"])
    assert dispatch(create, 0).status == 422
    create.body = std.bytes.fromString("{")
    assert dispatch(create, 0).status == 400
    create.body = std.bytes.fromString("{\"name\":\"Craft\"}")
    assert dispatch(create, 0).status == 201
}
