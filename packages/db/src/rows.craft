export func optionalTime(rows: DbRows, row: DbValue[], name: String): DateTime? {
    let value: DbValue = valueAt(rows, row, name)
    if std.db.isNull(value) {
        return null
    }
    if std.db.kind(value) != "time" {
        throw Exception("DbTypeMismatch: column has another type")
    }
    return std.db.asTime(value)
}

export func expectAffected(result: DbResult, expected: Int) {
    if expected < 0 {
        throw Exception("DbAffectedRows: expected count cannot be negative")
    }
    if let count = result.affectedRows {
        if count == expected {
            return
        }
    }
    throw Exception("DbAffectedRows: affected count is unavailable or unexpected")
}
